# Backend server
PORT=5000

# Public URL used for uploaded assets in API responses.
# Local default:
# PUBLIC_BASE_URL=http://localhost:5000
PUBLIC_BASE_URL=

# MongoDB connection string
# Local example:
# MONGO_URI=mongodb://127.0.0.1:27017/resume-builder
MONGO_URI=

# JWT signing secret for user authentication.
# Use a long random value in real deployments.
JWT_SECRET=

# Optional AI model overrides when the frontend leaves the Model field blank.
# Set these to the exact model names you want your provider SDK/API to use.
# ANTHROPIC_MODEL=
# OPENAI_MODEL=
# DEEPSEEK_MODEL=

# Optional AI proxy safeguards.
# AI_ANALYZE_BODY_LIMIT=64kb
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_MAX_REQUESTS=10
